// regfile_bypass.hex - 거리 3 RAW 바이패스 검증
//
// reg_file.v 초기값 전제 (실패 시 초기값이 그대로 남아야 구분됨):
//   RF[10] $t2 = -1        RF[12] $t4 = 10        RF[14] $t6 = 0
//   RF[9]  $t1 = 1   <- 거리 3 실패 시 $t2 가 이 값(1)을 받음
//
// 기대 결과
//   $t2 = 0x00000002   거리 3 통과          (실패: 0x00000001)
//   $t4 = 0x00000000   $zero 보호 동작       (실패: 0x00002468)
//   $t6 = 0x00000007   거리 4 회귀           (실패: 0x00000000)

// --- 0. 파이프라인 X 배수 ----------------------------------------
// 리셋이 없어서 pipe_mem_wb 가 초기에 X 를 들고 있음.
// ID 바이패스 조건이 ctrl_regwrite_wb 에 의존하므로, X 가 선택 신호로
// 들어가면 삼항연산자 결과가 통째로 X 가 됨 -> 첫 명령어들이 오염됨.
// 리셋(버그 4)을 넣기 전까지는 앞에 nop 을 깔아 피한다.
00000000
00000000
00000000
00000000
00000000

// --- A. 거리 3 ---------------------------------------------------
20090002   // addi $t1, $zero, 2
00000000   // nop
00000000   // nop
01205020   // add  $t2, $t1, $zero     <- 거리 3. $t2 = 2 여야 함

// --- B. $zero 보호 -----------------------------------------------
200B1234   // addi $t3, $zero, 0x1234
016B0020   // add  $zero, $t3, $t3     <- regwrite=1, writereg=0. 버려져야 함
00000000   // nop
00000000   // nop
00006025   // or   $t4, $zero, $zero   <- 거리 3 으로 $zero 읽기. rs/rt 둘 다 테스트

// --- C. 거리 4 회귀 ----------------------------------------------
200D0007   // addi $t5, $zero, 7
00000000   // nop
00000000   // nop
00000000   // nop
01A07020   // add  $t6, $t5, $zero     <- 거리 4. 원래 통과하던 칸

// --- 파이프라인 배수 ---------------------------------------------
00000000
00000000
00000000
00000000
00000000
